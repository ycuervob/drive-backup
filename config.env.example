# =============================================================================
#  drive-backup · Archivo de configuración
#  Copia este archivo como config.env (setup.sh lo hace por ti) y ajústalo.
#  config.env NO se sube a git (.gitignore) y debe tener permisos 600.
#
#  Sintaxis bash: VAR="valor". Sin espacios alrededor del "=".
# =============================================================================

# -----------------------------------------------------------------------------
# 1. GENERAL
# -----------------------------------------------------------------------------

# Nombre del servidor. Se usa como carpeta en Drive y en los nombres de archivo.
SERVER_NAME="$(hostname -s)"

# Carpeta local donde queda el archivo final (y la carpeta temporal mientras se arma).
BACKUP_DIR="/var/log/drive-backup"

# Carpeta de logs (un archivo por ejecución).
LOG_DIR="/var/log/drive-backup"

# Días que se conservan los backups locales. 0 = borrar en cuanto se suban bien.
LOCAL_RETENTION_DAYS=3

# Días que se conservan los logs locales.
LOG_RETENTION_DAYS=30

# Espacio libre mínimo (MB) en BACKUP_DIR para empezar. 0 = no revisar.
MIN_FREE_MB=1024

# Archivo final: TODO lo que generen db.sh y files.sh se empaqueta en UN SOLO archivo:
#   <ARCHIVE_PREFIX>_<SERVER_NAME>_<AAAA-MM-DD_HHMMSS>.<zip|tar.gz>
#   ej: BackUp_servidor1_2026-09-27_020000.zip
# Solo ese archivo se sube a Drive.
ARCHIVE_FORMAT="zip"            # zip | tar.gz
ARCHIVE_PREFIX="BackUp"

# Qué partes se ejecutan (true/false).
ENABLE_DB=true
ENABLE_FILES=true

# Si db.sh o files.sh fallan: ¿se sube igual lo que sí se generó? (true/false)
# false = no se sube nada y el backup queda marcado como fallido.
UPLOAD_ON_PARTIAL_FAILURE=false

# -----------------------------------------------------------------------------
# 2. GOOGLE DRIVE (rclone)
# -----------------------------------------------------------------------------
# DRIVE_AUTH define cómo se autentica:
#   token            -> OAuth con tu cuenta. Pega abajo el token de `rclone authorize "drive"`.
#   service_account  -> Cuenta de servicio (JSON). Solo sirve con Unidades compartidas.
#   rclone_remote    -> Usa un remote ya creado con `rclone config` (ver RCLONE_REMOTE).
DRIVE_AUTH="token"

# Carpeta destino dentro de Drive. Estructura final:
#   <DRIVE_PATH>/<SERVER_NAME>/BackUp_<SERVER_NAME>_<AAAA-MM-DD_HHMMSS>.zip
DRIVE_PATH="Backups"

# Días que se conservan los backups en Drive. 0 = nunca borrar.
REMOTE_RETENTION_DAYS=30

# true = al borrar backups viejos en Drive, van a la papelera (liberan espacio a los 30 días).
# false = se borran definitivamente.
DRIVE_USE_TRASH=false

# --- Para DRIVE_AUTH="token" ---
# Opcional pero recomendado: client_id/secret propios (Google Cloud Console > APIs > Credenciales).
# Si los usas, el token debe generarse con:  rclone authorize "drive" "CLIENT_ID" "CLIENT_SECRET"
DRIVE_CLIENT_ID=""
DRIVE_CLIENT_SECRET=""
# Token JSON completo, entre comillas SIMPLES. Ejemplo:
# DRIVE_TOKEN='{"access_token":"ya29...","token_type":"Bearer","refresh_token":"1//0g...","expiry":"2026-09-24T10:00:00-05:00"}'
DRIVE_TOKEN=''

# --- Para DRIVE_AUTH="service_account" ---
DRIVE_SERVICE_ACCOUNT_FILE=""   # ruta absoluta al JSON, ej: /etc/drive-backup/sa.json

# --- Comunes a token y service_account (opcionales) ---
DRIVE_SCOPE="drive"             # drive (completo) | drive.file (solo archivos creados por rclone)
DRIVE_TEAM_DRIVE=""             # ID de la Unidad compartida (vacío = Mi unidad)
DRIVE_ROOT_FOLDER_ID=""         # ID de una carpeta concreta como raíz (vacío = raíz)

# --- Para DRIVE_AUTH="rclone_remote" ---
RCLONE_REMOTE="gdrive"          # nombre del remote (sin los dos puntos)
RCLONE_CONFIG_FILE=""           # vacío = ~/.config/rclone/rclone.conf del usuario que ejecuta

# --- Ajustes de subida ---
RCLONE_BWLIMIT=""               # límite de ancho de banda, ej: "10M" o "08:00,5M 20:00,off". Vacío = sin límite
VERIFY_UPLOAD=true              # compara el md5 local vs Drive después de subir
RCLONE_EXTRA_FLAGS=""           # flags extra para rclone copy, ej: "--drive-chunk-size 64M"

# -----------------------------------------------------------------------------
# 3. VARIABLES PARA TUS SCRIPTS (db.sh y files.sh)
# -----------------------------------------------------------------------------
# Define aquí lo que usen tus comandos: contraseñas, nombres de contenedores,
# rutas... Los nombres son libres; úsalos en db.sh / files.sh como $VARIABLE.
# Así las credenciales quedan en un solo archivo protegido (chmod 600).
DB_USER="root"
DB_PASSWORD=""
# DB_CONTAINER="mysql_prod"
# SITE_DIR="/var/www/html"

# -----------------------------------------------------------------------------
# 4. NOTIFICACIONES (opcional)
# -----------------------------------------------------------------------------
# Webhook que recibe un POST JSON {"text": "..."} (Google Chat, Slack, Discord, Teams...).
NOTIFY_WEBHOOK_URL=""
# Cuándo notificar: always | error | never
NOTIFY_ON="error"
# Correo (requiere el comando `mail` configurado en el servidor). Vacío = no enviar.
NOTIFY_EMAIL=""
