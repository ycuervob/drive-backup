#!/usr/bin/env bash
# =============================================================================
#  drive-backup · db.sh  (PLANTILLA LIBRE)
#
#  Aquí escribes TUS comandos para respaldar la base de datos de ESTE servidor.
#  No hay nada fijo: mysqldump, pg_dump, docker exec, copiar una carpeta... lo
#  que necesites. La única regla:
#
#      Todo lo que dejes dentro de  $OUT  se sube a Drive.
#      (archivos o carpetas, comprimidos o no)
#
#  - Si un comando falla, el script se detiene y backup.sh NO sube nada.
#  - Las variables de config.env están disponibles ($DB_PASSWORD, etc.).
#  - Para probarlo solo:  ./db.sh     (deja todo en ./test-output/db)
#
#  Abajo hay ejemplos comentados. Descomenta el que se parezca a tu caso,
#  ajústalo y borra el resto.
# =============================================================================
set -Eeo pipefail
source "$(dirname "$(readlink -f "$0")")/lib/common.sh"
load_config
LOG_TAG="db"

OUT="${DB_OUT_DIR:-$DRIVE_BACKUP_HOME/test-output/db}"   # <- deja aquí tus backups
STAMP="${RUN_ID:-$(date +%F_%H%M%S)}"                     # fecha para nombrar archivos
mkdir -p "$OUT"

# =============================================================================
#  TUS COMANDOS AQUÍ
# =============================================================================

log_info "Edita db.sh con los comandos de este servidor"
exit 1   # <- borra esta línea cuando hayas puesto tus comandos


# -----------------------------------------------------------------------------
# Ejemplo 1 · mysqldump directo
# -----------------------------------------------------------------------------
# MYSQL_PWD="$DB_PASSWORD" mysqldump -u "$DB_USER" \
#   --single-transaction --routines --triggers --all-databases \
#   | gzip > "$OUT/mysql_$STAMP.sql.gz"

# -----------------------------------------------------------------------------
# Ejemplo 2 · mysqldump dentro de un contenedor Docker
# -----------------------------------------------------------------------------
# docker exec -e MYSQL_PWD="$DB_PASSWORD" mi_contenedor_mysql \
#   mysqldump -u root --single-transaction --routines --all-databases \
#   | gzip > "$OUT/mysql_docker_$STAMP.sql.gz"
#
# (docker compose:  docker compose -f /ruta/docker-compose.yml exec -T db mysqldump ...)

# -----------------------------------------------------------------------------
# Ejemplo 3 · copiar la carpeta _data de PostgreSQL (volumen Docker)
# -----------------------------------------------------------------------------
# Ojo: copiar _data con Postgres encendido puede dar una copia inconsistente.
# Lo seguro es detener el contenedor un momento:
#
# docker stop mi_postgres
# trap 'docker start mi_postgres' EXIT            # se vuelve a encender aunque algo falle
# tar -czf "$OUT/postgres_data_$STAMP.tar.gz" -C /var/lib/docker/volumes/mi_volumen _data
#
# ...o si prefieres subir la carpeta tal cual, sin comprimir:
# cp -a /var/lib/docker/volumes/mi_volumen/_data "$OUT/postgres_data"

# -----------------------------------------------------------------------------
# Ejemplo 4 · pg_dump (normal o dentro de Docker)
# -----------------------------------------------------------------------------
# PGPASSWORD="$DB_PASSWORD" pg_dump -h localhost -U "$DB_USER" -Fc mibd > "$OUT/mibd_$STAMP.dump"
# docker exec mi_postgres pg_dump -U postgres -Fc mibd > "$OUT/mibd_$STAMP.dump"

# -----------------------------------------------------------------------------
# Ejemplo 5 · varias bases, un archivo por cada una
# -----------------------------------------------------------------------------
# for db in wordpress moodle; do
#   MYSQL_PWD="$DB_PASSWORD" mysqldump -u "$DB_USER" --single-transaction "$db" \
#     | gzip > "$OUT/${db}_$STAMP.sql.gz"
#   log_info "OK $db"
# done

log_info "Listo: $(du -sh "$OUT" | cut -f1) en $OUT"
